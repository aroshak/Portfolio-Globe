{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "satellite.js/dist/io.js": ["./node_modules/satellite.js/dist/io.d.ts"],
      "satellite.js/dist/propagation.js": ["./node_modules/satellite.js/dist/propagation.d.ts"],
      "satellite.js/dist/transforms.js": ["./node_modules/satellite.js/dist/transforms.d.ts"]
    }
  },
  "include": ["src"]
}
